{
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/admin/:path*",
      "destination": "/api/router?__p=admin/:path*"
    },
    {
      "source": "/api/groups",
      "destination": "/api/router?__p=groups"
    },
    {
      "source": "/api/group-request",
      "destination": "/api/router?__p=group-request"
    },
    {
      "source": "/api/access",
      "destination": "/api/router?__p=access"
    },
    {
      "source": "/api/link-email",
      "destination": "/api/router?__p=link-email"
    },
    {
      "source": "/api/pay/:path*",
      "destination": "/api/router?__p=pay/:path*"
    },
    {
      "source": "/api/cron/:path*",
      "destination": "/api/router?__p=cron/:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/subs",
      "schedule": "0 8 * * *"
    }
  ]
}
